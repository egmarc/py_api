PY_API_APP_NAME="Py API"
PY_API_ENVIRONMENT=local
PY_API_DEBUG=false
# Use the RDS PostgreSQL endpoint and enforce TLS in production.
# PY_API_DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/py_api?sslmode=verify-full"
# Use a shared TLS-enabled Redis endpoint for authentication revocations.
# PY_API_REDIS_URL="rediss://redis.example.com:6379/0"

# Configure all of these for Cognito authentication. Supply the secret securely,
# not in a committed file. URLs must use HTTPS and must not end in a slash.
# PY_API_COGNITO_ISSUER="https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example"
# PY_API_COGNITO_DOMAIN="https://example.auth.us-east-1.amazoncognito.com"
# PY_API_COGNITO_CLIENT_ID="example-client-id"
# PY_API_COGNITO_CLIENT_SECRET="..."
# PY_API_COGNITO_AUDIENCE="https://api.example.com"
# PY_API_COGNITO_ADMIN_GROUP="admins"
# PY_API_COGNITO_SCOPE="openid"
# PY_API_AUTH_REDIRECT_URI="https://api.example.com/api/auth/callback"
# PY_API_FRONTEND_ORIGIN="https://app.example.com"
# PY_API_FRONTEND_REDIRECT_URL="https://app.example.com/"
# PY_API_REFRESH_COOKIE_MAX_AGE=2592000
# PY_API_COGNITO_REFRESH_TOKEN_LIFETIME=2592000
